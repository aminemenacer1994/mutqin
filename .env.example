APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
# Production (Laravel Cloud): https://app.mutqin.ai
# Local development: override to http://localhost (or http://127.0.0.1:8000)
APP_URL=https://app.mutqin.ai
SPEECHMATICS_API_KEY=
SPEECHMATICS_REGION=eu
# Daily Speechmatics cost guard (AI Recite / Check memorisation). UTC day, cache-backed.
# Enabled by default so a forgotten key cannot mint tokens unbounded.
# Each successful token mint lasts 2 minutes (SPEECHMATICS_TOKEN_TTL, default 120s).
#
# Small tester group (~5–15 people): keep these defaults
#   30 mints/user/day ≈ 60 session-minutes; 200 global ≈ 400 minutes.
# Production: raise after you know traffic, e.g.
#   SPEECHMATICS_DAILY_USER_TOKEN_MINTS=60
#   SPEECHMATICS_DAILY_GLOBAL_TOKEN_MINTS=2000
# Local hammering: SPEECHMATICS_USAGE_CAP_ENABLED=false
# 0 / empty / invalid numbers disable that axis (fail open) and log a warning.
# Optional minutes instead of (or as well as) mint counts — the tighter limit wins.
SPEECHMATICS_USAGE_CAP_ENABLED=true
SPEECHMATICS_DAILY_USER_TOKEN_MINTS=30
SPEECHMATICS_DAILY_GLOBAL_TOKEN_MINTS=200
# SPEECHMATICS_DAILY_USER_SESSION_MINUTES=60
# SPEECHMATICS_DAILY_GLOBAL_SESSION_MINUTES=400

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

SANCTUM_STATEFUL_DOMAINS=localhost,localhost:8000,localhost:3000,127.0.0.1,127.0.0.1:8000,::1

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

# Google OAuth (Socialite) — copy Client ID/Secret from Google Cloud Console →
# APIs & Services → Credentials → OAuth 2.0 Client IDs (Web application).
# Do not wrap values in quotes. Do not leave trailing spaces.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Exact match required in Google Cloud Console Authorized redirect URIs.
# Local examples (add both if you use either host):
#   http://localhost:8000/auth/google/callback
#   http://127.0.0.1:8000/auth/google/callback
# Production (must match Google Cloud Console exactly):
#   https://app.mutqin.ai/auth/google/callback
# Also add the production origin under Authorised JavaScript origins:
#   https://app.mutqin.ai
# During custom-domain migration, keep the Laravel Cloud hostname registered too
# until traffic is fully cut over.
GOOGLE_REDIRECT_URI="${APP_URL}/auth/google/callback"

# Stripe — create keys in Stripe Dashboard (test mode for local dev).
STRIPE_PUBLISHABLE_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_PREMIUM_MONTHLY=
STRIPE_PRICE_PREMIUM_YEARLY=
STRIPE_PRICE_PRO_MONTHLY=
STRIPE_PRICE_PRO_YEARLY=
VITE_APP_NAME="${APP_NAME}"

# Comma-separated Super Admin emails (Gate: access-admin). Example:
# MUTQIN_ADMIN_EMAILS=menacer72@gmail.com
MUTQIN_ADMIN_EMAILS=

# --- Laravel Cloud production (set in dashboard, not committed) ---
# APP_URL=https://app.mutqin.ai
# APP_ENV=production
# APP_DEBUG=false
# Demo login (staging / shared demo deploys)
# SHOW_DEMO_ACCOUNTS=true
# DEMO_LOGIN_EMAIL=layla.beginner@mutqin.test
# DEMO_LOGIN_PASSWORD=DemoPass1!
# Optional richer demo data: php artisan db:seed --class=DemoDataSeeder --force
# GOOGLE_REDIRECT_URI=https://app.mutqin.ai/auth/google/callback
# SESSION_DOMAIN=null  (leave unset/null — do not use .mutqin.ai unless cross-subdomain auth is required)
# SESSION_SECURE_COOKIE=true  (optional; Laravel sets secure cookies automatically on HTTPS)
# SANCTUM_STATEFUL_DOMAINS=app.mutqin.ai  (optional; config/sanctum.php also derives hosts from APP_URL + the current request)
# Stripe webhook endpoint: https://app.mutqin.ai/api/stripe/webhook (update in Stripe Dashboard)
# After changing env vars: php artisan config:clear && php artisan config:cache
