APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
# Production (Laravel Cloud): https://app.mutqin.ai
# Local development: override to http://localhost (or http://127.0.0.1:8000)
APP_URL=https://app.mutqin.ai
SPEECHMATICS_API_KEY=
SPEECHMATICS_REGION=eu
# Realtime token TTL (seconds). Each mint ≈ one short AI check session.
SPEECHMATICS_TOKEN_TTL=120

# --- Speechmatics provider reference (informational — set after raising cap in Speechmatics portal) ---
# Not enforced via API. Used for soft-cap alerts vs. your account budget.
# See docs/speechmatics-capacity.md for which dashboard limit to raise and how to verify.
# SPEECHMATICS_PROVIDER_DAILY_SESSION_MINUTES=
# SPEECHMATICS_PROVIDER_DAILY_TOKEN_MINTS=

# --- Application daily cost guard (AI Recite / Check memorisation). UTC day, cache-backed. ---
# Enabled by default so a forgotten key cannot mint tokens unbounded.
# Keep application limits BELOW your Speechmatics provider reference.
#
# Small tester group (~5–15 people): keep these defaults
#   30 mints/user/day ≈ 60 session-minutes; 200 global ≈ 400 minutes.
# Production: raise after you know traffic, e.g.
#   SPEECHMATICS_DAILY_USER_TOKEN_MINTS=60
#   SPEECHMATICS_DAILY_GLOBAL_TOKEN_MINTS=2000
# Local hammering: SPEECHMATICS_USAGE_CAP_ENABLED=false
# 0 / empty / invalid numbers disable that axis and log a warning.
# Local/testing fail open. Production fails closed (no mints) until limits are valid.
# Optional minutes instead of (or as well as) mint counts — the tighter limit wins.
SPEECHMATICS_USAGE_CAP_ENABLED=true
SPEECHMATICS_DAILY_USER_TOKEN_MINTS=30
SPEECHMATICS_DAILY_GLOBAL_TOKEN_MINTS=200
# SPEECHMATICS_DAILY_USER_SESSION_MINUTES=60
# SPEECHMATICS_DAILY_GLOBAL_SESSION_MINUTES=400
# Optional stricter kill-switch (must be lower than daily global cap):
# SPEECHMATICS_EMERGENCY_GLOBAL_TOKEN_MINTS=
# SPEECHMATICS_EMERGENCY_GLOBAL_SESSION_MINUTES=
# Soft-cap log thresholds (% of limit). Per-user rate limits still apply regardless.
SPEECHMATICS_USAGE_WARN_PERCENT=80
SPEECHMATICS_USAGE_CRITICAL_PERCENT=95

# Server-side burst guard for POST /memorisation/transcription-token (before Speechmatics).
# Counts every attempt including failed upstream mints. Compatible with normal AMD + soft-recover.
# Admin/demo bypass stays off unless you explicitly enable it.
SPEECHMATICS_RATE_LIMIT_ENABLED=true
SPEECHMATICS_RATE_LIMIT_PER_USER_PER_MINUTE=10
SPEECHMATICS_RATE_LIMIT_PER_IP_PER_MINUTE=30
SPEECHMATICS_RATE_LIMIT_BURST_PER_USER=3
SPEECHMATICS_RATE_LIMIT_BURST_SECONDS=10
# SPEECHMATICS_RATE_LIMIT_BYPASS_ADMIN=false
# SPEECHMATICS_RATE_LIMIT_BYPASS_DEMO=false

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# Sentry (single error-tracking provider). Leave empty locally — events still
# go to storage/logs via MutqinLog. Set the DSN in Laravel Cloud / staging.
# Never commit a DSN. send_default_pii stays off (user id only, no email/IP).
# SENTRY_LARAVEL_DSN=
# SENTRY_DSN=
# SENTRY_RELEASE=
# MUTQIN_RELEASE=
# MUTQIN_ASSET_BUILD=v165
# SENTRY_ENVIRONMENT=staging
# SENTRY_TRACES_SAMPLE_RATE=0
# SENTRY_SEND_DEFAULT_PII=false
# ERROR_TRACKING_PROBE_ENABLED=true

# Production health / uptime (see docs/monitoring.md). Public GET /health is always
# available. Internal probes follow the same staging-open / production-admin pattern.
# MONITORING_PROBE_ENABLED=true
# MONITORING_INTERNAL_TOKEN=
# MONITORING_SCHEDULER_MAX_AGE=180
# MONITORING_WORKER_MAX_AGE=300
# MONITORING_ALERT_COOLDOWN=300
# MONITORING_EVALUATE_ENABLED=true

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
# Production: SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=null

SANCTUM_STATEFUL_DOMAINS=localhost,localhost:8000,localhost:3000,127.0.0.1,127.0.0.1:8000,::1

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false
# Laravel Cloud Object Storage (private bucket) also injects FILESYSTEM_DISK / AWS_* when attached.
# AWS_ENDPOINT=
# AWS_URL=

# --- Durable user files (feedback screenshots) ---
# Local default uses storage/app/private. Laravel Cloud filesystems are ephemeral —
# attach a *private* Object Storage bucket and point MUTQIN_USER_FILES_DISK at it
# (disk name from the Cloud canvas, often `s3` or `user_files`).
# MUTQIN_USER_FILES_DISK=local
# MUTQIN_USER_FILES_DRIVER=local
# Production example (private bucket attached as disk `s3`):
# MUTQIN_USER_FILES_DISK=s3

# --- Backups (see docs/backups.md) ---
# Layer 1 (required on Laravel Cloud): Org → Resources → Databases → Backups → Daily,
# retention 1–30 days (recommend 30). Snapshots are private platform storage.
# MUTQIN_CLOUD_MYSQL_BACKUP_RETENTION_DAYS=30
#
# Layer 2 (optional app-level encrypted archives via spatie/laravel-backup):
# Enable only after private destination + password + scheduler are ready.
# MUTQIN_BACKUP_ENABLED=false
# BACKUP_NAME=mutqin
# BACKUP_DISK=backups
# BACKUP_DISK_DRIVER=local
# Local archives land under storage/app/private/backups (not publicly served).
# Production: separate *private* Object Storage / S3-compatible bucket:
# BACKUP_DISK_DRIVER=s3
# BACKUP_AWS_ACCESS_KEY_ID=
# BACKUP_AWS_SECRET_ACCESS_KEY=
# BACKUP_AWS_DEFAULT_REGION=auto
# BACKUP_AWS_BUCKET=
# BACKUP_AWS_ENDPOINT=
# BACKUP_AWS_USE_PATH_STYLE_ENDPOINT=false
# Zip encryption password (required when BACKUP_REQUIRE_ENCRYPTION=true). Never commit.
# BACKUP_ARCHIVE_PASSWORD=
# BACKUP_REQUIRE_ENCRYPTION=true
# BACKUP_VERIFY=true
# Retention tiers (Spatie default strategy):
# BACKUP_KEEP_ALL_DAYS=7
# BACKUP_KEEP_DAILY_DAYS=16
# BACKUP_KEEP_WEEKLY_WEEKS=8
# BACKUP_KEEP_MONTHLY_MONTHS=12
# BACKUP_KEEP_YEARLY_YEARS=2
# BACKUP_MAX_STORAGE_MB=10240
# Schedule (UTC, requires Laravel Cloud scheduler enabled):
# BACKUP_CLEAN_AT=01:00
# BACKUP_RUN_AT=01:30
# BACKUP_MONITOR_AT=02:00
# Failure alerts (mail) — also logged as backup.run.failed / reported to Sentry when DSN set:
# BACKUP_NOTIFICATION_MAIL=ops@example.com
# BACKUP_NOTIFICATION_WEBHOOK_URL=
# Optional mysqldump directory (no binary name) if not on PATH:
# BACKUP_DB_DUMP_BINARY_PATH=
# BACKUP_DB_DUMP_TIMEOUT=900
# BACKUP_DB_DUMP_SKIP_SSL=false
# BACKUP_DB_DUMP_EXTRA_OPTIONS=
# Manual gate before destructive ops: php artisan mutqin:deploy-preflight --require-backup
# MUTQIN_BACKUP_CONFIRMED=0

# Google OAuth (Socialite) — copy Client ID/Secret from Google Cloud Console →
# APIs & Services → Credentials → OAuth 2.0 Client IDs (Web application).
# Do not wrap values in quotes. Do not leave trailing spaces.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Exact match required in Google Cloud Console Authorized redirect URIs.
# Local examples (add both if you use either host):
#   http://localhost:8000/auth/google/callback
#   http://127.0.0.1:8000/auth/google/callback
# Production (must match Google Cloud Console exactly):
#   https://app.mutqin.ai/auth/google/callback
# Also add the production origin under Authorised JavaScript origins:
#   https://app.mutqin.ai
# During custom-domain migration, keep the Laravel Cloud hostname registered too
# until traffic is fully cut over.
GOOGLE_REDIRECT_URI="${APP_URL}/auth/google/callback"

# Google Analytics 4 — public Measurement ID (safe to commit). Leave empty to disable.
# Enabled automatically when APP_ENV=production. Local: GOOGLE_ANALYTICS_ENABLED=true
GOOGLE_ANALYTICS_ID=G-W4K8J2T0SG
# GOOGLE_ANALYTICS_ENABLED=true

# Stripe — create keys in Stripe Dashboard (test mode for local dev).
STRIPE_PUBLISHABLE_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_PREMIUM_MONTHLY=
STRIPE_PRICE_PREMIUM_YEARLY=
STRIPE_PRICE_PRO_MONTHLY=
STRIPE_PRICE_PRO_YEARLY=
VITE_APP_NAME="${APP_NAME}"

# Email verification gate (verify notice page + verified middleware). Off by default for now.
# AUTH_REQUIRE_EMAIL_VERIFICATION=true

# MVP admin allowlist (normalized exact match) + register/profile deny-list.
# Privilege requires users.is_admin AND verified email AND (if set) allowlist match.
# Verified Google sign-in for an allowlisted mailbox creates/restores is_admin automatically.
# MUTQIN_ADMIN_EMAILS=admin@example.com
MUTQIN_ADMIN_EMAILS=

# Microphone / AI audio privacy (AI Recite + Check memorisation).
# Bump MUTQIN_AUDIO_PRIVACY_POLICY_VERSION to re-prompt consent after material policy changes.
MUTQIN_AUDIO_PRIVACY_POLICY_VERSION=2026-09-01
MUTQIN_AUDIO_PROCESSOR_NAME=Speechmatics
# never | temporary | retain — Mutqin servers never store raw learner audio in assessment tables.
# temporary (default): short-lived local/temp files, then deleted by cleanup jobs.
MUTQIN_RAW_RECORDING_RETENTION=temporary
MUTQIN_TEMPORARY_RECORDING_TTL_HOURS=24
# Legacy alias (prefer MUTQIN_RAW_RECORDING_RETENTION): MUTQIN_RETAIN_RAW_AUDIO=false

# --- Laravel Cloud production (set in dashboard, not committed) ---
# APP_URL=https://app.mutqin.ai
# APP_ENV=production
# APP_DEBUG=false
# Optional CDN / asset host for Mix (mix() / asset()). Leave empty to serve from APP_URL.
# Must be HTTPS in production and match the public origin browsers use.
# ASSET_URL=
# Bump after material frontend releases so clients clear Mutqin SW caches:
# MUTQIN_ASSET_BUILD=v166
# Demo login on /login. Defaults on. Set false to hide the shortcut.
# SHOW_DEMO_ACCOUNTS=true
# DEMO_LOGIN_EMAIL=layla.beginner@mutqin.test
# DEMO_LOGIN_PASSWORD=DemoPass1!
# Optional richer demo data (local/staging only — seeders abort in production):
#   php artisan db:seed --class=DemoDataSeeder
# Production DB release: MUTQIN_DEPLOY_STAGE=production ./scripts/deploy/production-release.sh
# Before explicitly destructive ops: take a backup, then
#   MUTQIN_BACKUP_CONFIRMED=1 php artisan mutqin:deploy-preflight --require-backup
# See docs/database-deploy-safety.md
# GOOGLE_REDIRECT_URI=https://app.mutqin.ai/auth/google/callback
# SESSION_DOMAIN=null  (leave unset/null — do not use .mutqin.ai unless cross-subdomain auth is required)
# SESSION_SECURE_COOKIE=true  (optional; Laravel sets secure cookies automatically on HTTPS)
# SANCTUM_STATEFUL_DOMAINS=app.mutqin.ai  (optional; config/sanctum.php also derives hosts from APP_URL + the current request)
# Stripe webhook endpoint: https://app.mutqin.ai/api/stripe/webhook (update in Stripe Dashboard)
# GOOGLE_ANALYTICS_ID=G-W4K8J2T0SG
# After changing env vars: php artisan config:clear && php artisan config:cache
# Error tracking: SENTRY_LARAVEL_DSN=  SENTRY_ENVIRONMENT=production  SENTRY_RELEASE=<git-sha>
# See docs/ERROR_TRACKING.md — never enable SENTRY_SEND_DEFAULT_PII.
# Uptime: point external monitor at https://app.mutqin.ai/health (alert on HTTP 503).
# Enable Laravel Cloud scheduler + worker; Slack resource alerts; SSL is auto-renewed.
# See docs/monitoring.md
