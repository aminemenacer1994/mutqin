# Ackee dashboard login (required). Do not commit the real .env.
ACKEE_USERNAME=admin
ACKEE_PASSWORD=change-me-now

# Host port for local `docker compose up` (http://127.0.0.1:3000).
ACKEE_HOST_PORT=3000

# CORS: sites allowed to POST page views / events to Ackee.
ACKEE_ALLOW_ORIGIN=https://mutqin.ai,https://app.mutqin.ai,http://127.0.0.1:8000,http://localhost:8000
ACKEE_AUTO_ORIGIN=true

# Used only with docker-compose.https.yml
ACKEE_PUBLIC_HOST=analytics.mutqin.ai
